    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGJWlvFk_3VF8QgLTs0N9E88bSFDbT0ODwJcBai3FcSd65D5uAHjJPNLMpnRdqOP47aAYFzjXDzyz8DrWytti3Zty8zvZig_hgekaVBSuJsr9jjurYI3VuXJunsz-Ly6JOYOyrhjA1MCqGin_tYoVM8_GI6zYcy2XnxCg=="
