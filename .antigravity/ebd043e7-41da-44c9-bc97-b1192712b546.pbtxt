0\265\331\210\330\261 \331\210\330\271\330\261\330\266\331\207\330\247.\n- **\331\210\330\266\330\271 \330\247\331\204\331\205\330\255\330\247\331\203\330\247\330\251 \330\247\331\204\330\252\331\204\331\202\330\247\330\246\331\212 \330\247\331\204\330\242\331\205\331\206 (Fallback Mode)**: \330\245\330\260\330\247 \331\204\331\205 \330\252\331\202\331\205 \330\250\330\245\330\271\330\257\330\247\330\257 \330\247\331\204\331\205\331\201\330\247\330\252\331\212\330\255 \330\250\330\271\330\257\330\214 \331\201\330\245\331\206 \330\247\331\204\331\205\331\210\331\202\330\271 **\331\204\331\206 \331\212\330\252\331\210\331\202\331\201 \330\243\331\210 \331\212\330\252\330\271\330\267\331\204**\330\233 \330\250\331\204 \330\263\331\212\331\202\331\210\331\205 \330\250\330\252\330\264\330\272\331\212\331\204 \331\202\330\247\330\271\330\257\330\251 \330\250\331\212\330\247\331\206\330\247\330\252 \331\205\330\255\331\204\331\212\330\251 \330\260\331\203\331\212\330\251 \331\210\331\205\330\255\330\247\331\203\330\247\330\251 \330\242\331\205\331\206\330\251 \330\250\330\247\331\204\331\203\330\247\331\205\331\204 \331\204\331\204\330\261\331\201\330\271 \331\210\330\247\331\204\330\252\330\256\330\262\331\212\331\206 (\330\252\330\256\330\262\331\212\331\206 \330\247\331\204\330\265\331\210\330\261 \331\205\330\255\331\204\331\212\330\247\331\213 \330\250\330\247\331\204\330\256\330\247\330\257\331\205 \331\210\330\271\330\261\330\266\331\207\330\247 \331\205\331\206 \331\205\330\263\330\247\330\261 `/uploads` \330\247\331\204\330\247\331\201\330\252\330\261\330\247\330\266\331\212)\330\214 \331\205\331\205\330\247 \331\212\330\252\331\212\330\255 \331\204\331\203 \330\252\330\254\330\261\330\250\330\251 \330\247\330\263\330\252\330\256\330\257\330\247\331\205 \331\203\330\247\331\205\331\204\330\251 \331\210\330\245\330\266\330\247\331\201\330\251 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \331\210\330\247\330\256\330\252\330\250\330\247\330\261 \331\204\3