          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "CREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\331\202\330\261\330\247\330\241\330\251\" ON games FOR SELECT USING (true);"
