        lines {
          text: "            <pre className=\"p-4 bg-slate-900 text-slate-100 rounded-2xl text-[11px] font-mono overflow-x-auto text-left leading-normal border border-slate-800 shadow-inner-sm max-h-48 scrollbar\">"
