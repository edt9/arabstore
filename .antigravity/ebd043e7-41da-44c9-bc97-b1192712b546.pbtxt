4\331\207 \330\250\330\271\330\257** \331\201\331\212 \331\205\330\256\330\267\330\267 \330\247\331\204\331\200 Schema \330\247\331\204\330\256\330\247\330\265 \330\250\331\203.\n   - **\330\247\331\204\330\255\331\204:** \331\202\331\205\330\252 \330\250\330\252\330\271\330\257\331\212\331\204 \331\206\330\270\330\247\331\205 \330\247\331\204\331\201\330\255\330\265 \330\247\331\204\330\250\330\261\331\205\330\254\331\212 \331\201\331\212 \330\247\331\204\330\256\331\204\331\201\331\212\330\251 \331\204\331\212\330\252\330\271\330\261\331\201 \330\271\331\204\331\211 \331\207\330\260\330\247 \330\247\331\204\330\256\330\267\330\243 \330\252\331\204\331\202\330\247\330\246\331\212\330\247\331\213 \331\203\330\245\330\264\330\247\330\261\330\251 \330\245\331\204\331\211 \330\243\331\206 \330\247\331\204\330\254\330\257\331\210\331\204 \331\205\331\201\331\202\331\210\330\257 (`isTableMissing`). \330\271\331\206\330\257 \330\255\330\257\331\210\330\253 \330\260\331\204\331\203\330\214 \331\212\331\202\331\210\331\205 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \330\252\331\204\331\202\330\247\330\246\331\212\330\247\331\213 **\330\250\330\247\331\204\330\252\330\255\331\210\331\204 \330\247\331\204\330\263\331\204\330\263 \330\245\331\204\331\211 \330\247\331\204\330\252\330\256\330\262\331\212\331\206 \331\210\330\247\331\204\331\205\330\255\330\247\331\203\330\247\330\251 \330\247\331\204\331\205\330\255\331\204\331\212\330\251 (Local Storage)** \331\204\330\266\331\205\330\247\331\206 \330\271\331\205\331\204 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \331\210\331\202\330\261\330\247\330\241\330\251 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \330\250\330\263\331\204\330\247\330\263\330\251 \330\252\330\247\331\205\330\251\330\214 \331\203\331\205\330\247 \331\212\330\271\330\261\330\266 \331\204\331\210\330\255\330\251 \330\245\330\261\330\264\330\247\330\257\331\212\330\251 \331\205\331\205\330\252\330\247\330\262\330\251 \