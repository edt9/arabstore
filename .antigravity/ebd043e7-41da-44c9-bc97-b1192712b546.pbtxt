      chunks {
        position: 11
        markdown_chunk {
          headers {
            type: MARKDOWN_NODE_TYPE_HEADER_1
            text: "PostgREST schema cache not updating - PGRST204 errors\302\240#42183"
          }
          headers {
            type: MARKDOWN_NODE_TYPE_HEADER_2
            text: "Description"
