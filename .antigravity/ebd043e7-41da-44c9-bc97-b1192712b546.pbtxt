    instruction: "Add SQL setup helper card and table existence status indicator to AdminPanel.tsx"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Top Welcome Panel with Credentials State */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-800/80 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6\">\n        <div className=\"space-y-1\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"h-2.5 w-2.5 rounded-full bg-emerald-500 animate-ping\" />\n            <h1 className=\"text-xl md:text-2xl font-black text-slate-900 dark:text-slate-100\">\n              \331\205\330\261\330\255\330\250\330\247\331\213 \330\250\331\203 \331\201\331\212 \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\330\271\330\247\331\205\330\251 \360\237\221\213\n            </h1>\n          </div>\n          <p className=\"text-sm text-slate-500 dark:text-slate-400\">\n            \330\243\331\206\330\252 \331\205\330\263\330\254\331\204 \330\247\331\204\330\257\330\256\331\210\331\204 \330\250\330\265\331\201\330\252\331\203 \330\243\330\257\331\205\331\206 \330\250\331\205\331\210\330\254\330\250 \330\247\331\204\330\255\330\263\330\247\330\250: <strong className=\"text-slate-700 dark:text-slate-300\">{adminEmail}</strong>\n          </p>\n        </div>\n\n        {/* Configurations Health Checklist */}\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 ${config?.isSupabaseConnected ? \"bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/40\" : \"bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-100 dark:border-amber-900/30\"}`}>\n            <Database className=\"w-4 h-4\" />\n            <span>\331\202\330\247\330\271\330\257\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252: {config?.isSupabaseConnected ? \"Supabase \331\205\330\252\330\265\331\204\" : \"\331\205\330\255\330\247\331\203\330\247\330\251 \331\205\330\255\331\204\331\212\330\251 \331\206\330\264\330\267\330\251\"}</span>\n          </div>\n\n          <div className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 ${config?.isCloudinaryConnected ? \"bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/40\" : \"bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-100 dark:border-amber-900/30\"}`}>\n            <CloudLightning className=\"w-4 h-4\" />\n            <span>\330\261\331\201\330\271 \330\247\331\204\330\265\331\210\330\261: {config?.isCloudinaryConnected ? \"Cloudinary \331\206\330\264\330\267\" : \"\330\252\330\256\330\262\331\212\331\206 \331\205\330\255\331\204\331\212 \331\206\330\264\330\267\"}</span>\n          </div>\n\n          <button\n            onClick={onLogout}\n            className=\"px-4 py-2 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/20 dark:hover:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold rounded-xl text-xs transition-colors flex items-center gap-1.5\"\n          >\n            <LogOut className=\"w-4 h-4\" />\n            \330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\256\330\261\331\210\330\254\n          </button>\n        </div>\n      </div>\n\n      {/* Messages */}\n      {successMsg && (\n        <div className=\"p-4 bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40 rounded-2xl text-emerald-800 dark:text-emerald-400 text-sm flex items-center gap-2 animate-bounce\">\n          <CheckCircle className=\"w-5 h-5 shrink-0\" />\n          <span>{successMsg}</span>\n        </div>\n      )}\n\n      {errorMsg && (\n        <div className=\"p-4 bg-rose-50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/40 rounded-2xl text-rose-800 dark:text-rose-400 text-sm flex items-start gap-2\">\n          <AlertCircle className=\"w-5 h-5 shrink-0 mt-0.5\" />\n          <span>{errorMsg}</span>\n        </div>\n      )}"
        replacement_content: "      {/* Top Welcome Panel with Credentials State */}\n      <div className=\"bg-white dark:bg-slate-900 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-800/80 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6\">\n        <div className=\"space-y-1\">\n          <div className=\"flex items-center gap-2\">\n            <span className={`h-2.5 w-2.5 rounded-full ${config?.isTableMissing ? \"bg-amber-500 animate-pulse\" : \"bg-emerald-500 animate-ping\"}`} />\n            <h1 className=\"text-xl md:text-2xl font-black text-slate-900 dark:text-slate-100\">\n              \331\205\330\261\330\255\330\250\330\247\331\213 \330\250\331\203 \331\201\331\212 \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\330\271\330\247\331\205\330\251 \360\237\221\213\n            </h1>\n          </div>\n          <p className=\"text-sm text-slate-500 dark:text-slate-400\">\n            \330\243\331\206\330\252 \331\205\330\263\330\254\331\204 \330\247\331\204\330\257\330\256\331\210\331\204 \330\250\330\265\331\201\330\252\331\203 \330\243\330\257\331\205\331\206 \330\250\331\205\331\210\330\254\330\250 \330\247\331\204\330\255\330\263\330\247\330\250: <strong className=\"text-slate-700 dark:text-slate-300\">{adminEmail}</strong>\n          </p>\n        </div>\n\n        {/* Configurations Health Checklist */}\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 ${\n            config?.isSupabaseConnected \n              ? config?.isTableMissing\n                ? \"bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-100 dark:border-amber-900/30\"\n                : \"bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/40\" \n              : \"bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-100 dark:border-amber-900/30\"\n          }`}>\n            <Database className=\"w-4 h-4\" />\n            <span>\n              \331\202\330\247\330\271\330\257\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252: {\n                config?.isSupabaseConnected \n                  ? config?.isTableMissing\n                    ? \"Supabase \331\205\330\252\330\265\331\204 (\330\254\330\257\331\210\331\204 \331\206\330\247\331\202\330\265)\"\n                    : \"Supabase \331\205\330\252\330\265\331\204\" \n                  : \"\331\205\330\255\330\247\331\203\330\247\330\251 \331\205\330\255\331\204\331\212\330\251 \331\206\330\264\330\267\330\251\"\n              }\n            </span>\n          </div>\n\n          <div className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 ${config?.isCloudinaryConnected ? \"bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/40\" : \"bg-amber-50 dark:bg-amber-950/20 text-amber-700 dark:text-amber-400 border border-amber-100 dark:border-amber-900/30\"}`}>\n            <CloudLightning className=\"w-4 h-4\" />\n            <span>\330\261\331\201\330\271 \330\247\331\204\330\265\331\210\330\261: {config?.isCloudinaryConnected ? \"Cloudinary \331\206\330\264\330\267\" : \"\330\252\330\256\330\262\331\212\331\206 \331\205\330\255\331\204\331\212 \331\206\330\264\330\267\"}</span>\n          </div>\n\n          <button\n            onClick={onLogout}\n            className=\"px-4 py-2 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/20 dark:hover:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold rounded-xl text-xs transition-colors flex items-center gap-1.5\"\n          >\n            <LogOut className=\"w-4 h-4\" />\n            \330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\256\330\261\331\210\330\254\n          </button>\n        </div>\n      </div>\n\n      {/* Messages */}\n      {successMsg && (\n        <div className=\"p-4 bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40 rounded-2xl text-emerald-800 dark:text-emerald-400 text-sm flex items-center gap-2\">\n          <CheckCircle className=\"w-5 h-5 shrink-0\" />\n          <span>{successMsg}</span>\n        </div>\n      )}\n\n      {errorMsg && (\n        <div className=\"p-4 bg-rose-50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/40 rounded-2xl text-rose-800 dark:text-rose-400 text-sm flex items-start gap-2\">\n          <AlertCircle className=\"w-5 h-5 shrink-0 mt-0.5\" />\n          <span>{errorMsg}</span>\n        </div>\n      )}\n\n      {/* Supabase Missing Table Setup Helper Card */}\n      {config?.isSupabaseConnected && config?.isTableMissing && (\n        <div className=\"p-6 bg-amber-50/50 dark:bg-slate-900/50 border border-amber-200 dark:border-amber-900/40 rounded-3xl space-y-4 animate-fade-in\">\n          <div className=\"flex items-center gap-2.5 text-amber-800 dark:text-amber-400\">\n            <Database className=\"w-5.5 h-5.5\" />\n            <h3 className=\"font-extrabold text-base\">\342\232\240\357\270\217 \330\252\331\207\331\212\330\246\330\251 \330\254\330\257\331\210\331\204 \331\202\330\247\330\271\330\257\330\251 \330\250\331\212\330\247\331\206\330\247\330\252 Supabase \331\205\330\267\331\204\331\210\330\250\330\251</h3>\n          </div>\n          <div className=\"text-xs text-amber-900 dark:text-amber-300 leading-relaxed space-y-2 font-sans\">\n            <p>\n              \331\204\331\202\330\257 \330\252\331\205 \330\247\331\204\330\247\330\252\330\265\330\247\331\204 \330\250\331\200 <strong>Supabase</strong> \330\250\331\206\330\254\330\247\330\255 \330\250\331\205\331\210\330\254\330\250 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\330\250\331\212\330\246\330\251 \330\247\331\204\330\256\330\247\330\265\330\251 \330\250\331\203\330\214 \331\210\331\204\331\203\331\206 \330\254\330\257\331\210\331\204 \330\252\330\256\330\262\331\212\331\206 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \331\210\330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 <code>games</code> \330\272\331\212\330\261 \331\205\331\210\330\254\331\210\330\257 \330\255\330\247\331\204\331\212\330\247\331\213 \331\201\331\212 \331\202\330\247\330\271\330\257\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252.\n            </p>\n            <p>\n              \331\212\331\202\331\210\331\205 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \330\255\330\247\331\204\331\212\330\247\331\213 \330\250\330\252\331\201\330\271\331\212\331\204 <strong>\330\247\331\204\330\252\330\256\330\262\331\212\331\206 \331\210\330\247\331\204\331\205\330\255\330\247\331\203\330\247\330\251 \330\247\331\204\331\205\330\255\331\204\331\212\330\251 (Local Storage)</strong> \330\252\331\204\331\202\330\247\330\246\331\212\330\247\331\213 \331\204\330\252\331\205\331\203\331\212\331\206 \330\252\330\265\331\201\330\255 \331\210\330\245\330\266\330\247\331\201\330\251 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \331\205\330\250\330\247\330\264\330\261\330\251 \330\257\331\210\331\206 \330\252\331\210\331\202\331\201! \331\204\330\261\330\250\330\267 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\257\330\247\330\246\331\205\331\213\330\247 \331\201\331\212 \330\263\331\210\330\250\330\247\330\250\331\212\330\263\330\214 \331\212\330\261\330\254\331\211 \330\252\330\264\330\272\331\212\331\204 \331\203\331\210\330\257 SQL \330\247\331\204\330\252\330\247\331\204\331\212:\n            </p>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[10px] text-gray-500 font-mono\">schema.sql</span>\n              <button\n                onClick={() => {\n                  const sqlCode = `CREATE TABLE IF NOT EXISTS games (\n  id TEXT PRIMARY KEY,\n  name TEXT NOT NULL,\n  image_url TEXT NOT NULL,\n  version TEXT NOT NULL,\n  description TEXT NOT NULL,\n  size TEXT NOT NULL,\n  category TEXT NOT NULL CHECK (category IN (\'games\', \'apps\')),\n  sub_category TEXT,\n  download_url TEXT NOT NULL,\n  rating NUMERIC,\n  downloads_count BIGINT,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- \330\252\331\205\331\203\331\212\331\206 \330\263\331\212\330\247\330\263\330\247\330\252 \330\247\331\204\331\210\330\265\331\210\331\204 \331\210\330\247\331\204\330\255\331\205\330\247\331\212\330\251 \331\204\331\204\330\254\331\205\331\212\330\271 \331\204\331\202\330\261\330\247\330\241\330\251 \331\210\330\252\330\271\330\257\331\212\331\204 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252\nALTER TABLE games ENABLE ROW LEVEL SECURITY;\nDROP POLICY IF EXISTS \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\331\202\330\261\330\247\330\241\330\251\" ON games;\nDROP POLICY IF EXISTS \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\245\330\266\330\247\331\201\330\251\" ON games;\nDROP POLICY IF EXISTS \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\252\330\271\330\257\331\212\331\204\" ON games;\nDROP POLICY IF EXISTS \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\255\330\260\331\201\" ON games;\n\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\331\202\330\261\330\247\330\241\330\251\" ON games FOR SELECT USING (true);\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\245\330\266\330\247\331\201\330\251\" ON games FOR INSERT WITH CHECK (true);\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\252\330\271\330\257\331\212\331\204\" ON games FOR UPDATE USING (true);\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\255\330\260\331\201\" ON games FOR DELETE USING (true);`;\n\n                  navigator.clipboard.writeText(sqlCode);\n                  setSqlCopied(true);\n                  setTimeout(() => setSqlCopied(false), 3000);\n                }}\n                className=\"px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-[10px] font-bold transition-all shadow-sm flex items-center gap-1 cursor-pointer\"\n              >\n                {sqlCopied ? \"\330\252\331\205 \330\247\331\204\331\206\330\263\330\256! \342\234\223\" : \"\331\206\330\263\330\256 \331\203\331\210\330\257 SQL\"}\n              </button>\n            </div>\n\n            <pre className=\"p-4 bg-slate-900 text-slate-100 rounded-2xl text-[11px] font-mono overflow-x-auto text-left leading-normal border border-slate-800 shadow-inner-sm max-h-48 scrollbar\">\n{`CREATE TABLE IF NOT EXISTS games (\n  id TEXT PRIMARY KEY,\n  name TEXT NOT NULL,\n  image_url TEXT NOT NULL,\n  version TEXT NOT NULL,\n  description TEXT NOT NULL,\n  size TEXT NOT NULL,\n  category TEXT NOT NULL CHECK (category IN (\'games\', \'apps\')),\n  sub_category TEXT,\n  download_url TEXT NOT NULL,\n  rating NUMERIC,\n  downloads_count BIGINT,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\nALTER TABLE games ENABLE ROW LEVEL SECURITY;\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\331\202\330\261\330\247\330\241\330\251\" ON games FOR SELECT USING (true);\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\245\330\266\330\247\331\201\330\251\" ON games FOR INSERT WITH CHECK (true);\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\252\330\271\330\257\331\212\331\204\" ON games FOR UPDATE USING (true);\nCREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\255\330\260\331\201\" ON games FOR DELETE USING (true);`}\n            </pre>\n          </div>\n\n          <div className=\"text-[11px] text-amber-800/80 dark:text-amber-400/80 leading-normal font-sans pr-4 border-r-2 border-amber-300\">\n            <strong>\330\267\330\261\331\212\331\202\330\251 \330\247\331\204\330\252\331\201\330\271\331\212\331\204:</strong> \330\247\330\260\331\207\330\250 \330\245\331\204\331\211 \331\204\331\210\330\255\330\251 \330\252\330\255\331\203\331\205 \330\263\331\210\330\250\330\247\330\250\331\212\330\263 (Supabase Dashboard) &gt; \330\247\330\260\331\207\330\250 \330\245\331\204\331\211 <strong>SQL Editor</strong> &gt; \330\247\331\204\330\265\331\202 \330\247\331\204\331\203\331\210\330\257 \330\247\331\204\330\263\330\247\330\250\331\202 &gt; \330\247\331\206\331\202\330\261 \330\271\331\204\331\211 <strong>Run</strong>. \330\253\331\205 \330\247\330\266\330\272\330\267 \330\271\331\204\331\211 \330\262\330\261 \"\330\252\330\255\330\257\331\212\330\253 \330\247\331\204\331\205\330\271\330\261\330\266\" \330\243\331\210 \331\202\331\205 \330\250\330\252\330\255\330\257\331\212\330\253 \330\247\331\204\330\265\331\201\330\255\330\251 \331\210\330\263\331\212\330\271\331\205\331\204 \330\247\331\204\330\247\330\252\330\265\330\247\331\204 \330\247\331\204\330\263\330\255\330\247\330\250\331\212 \331\205\330\250\330\247\330\264\330\261\330\251!\n          </div>\n        </div>\n      )}"
