    user_response: "\330\243\330\261\331\212\330\257 \330\250\331\206\330\247\330\241 \331\205\331\210\331\202\330\271 \331\205\330\252\330\254\330\261 \330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\210\330\243\331\204\330\271\330\247\330\250 \331\203\330\247\331\205\331\204 \331\212\330\264\330\250\331\207 Google Play \331\205\331\206 \330\255\331\212\330\253 \330\247\331\204\331\201\331\203\330\261\330\251 \331\210\330\252\330\254\330\261\330\250\330\251 \330\247\331\204\330\247\330\263\330\252\330\256\330\257\330\247\331\205\330\214 \330\250\330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\252\330\265\331\205\331\212\331\205 \330\247\330\255\330\252\330\261\330\247\331\201\331\212 \331\210\330\255\330\257\331\212\330\253.\n\n## \330\247\331\204\331\207\330\257\331\201 \331\205\331\206 \330\247\331\204\331\205\331\210\331\202\330\271\n\n\330\245\331\206\330\264\330\247\330\241 \331\205\330\252\330\254\330\261 \330\243\331\204\330\271\330\247\330\250 \331\210\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\212\330\263\331\205\330\255 \331\204\331\204\331\205\330\263\330\252\330\256\330\257\331\205\331\212\331\206 \330\250\330\252\330\265\331\201\330\255 \330\247\331\204\330\243\331\204\330\271\330\247\330\250\330\214 \331\205\330\264\330\247\331\207\330\257\330\251 \330\247\331\204\330\252\331\201\330\247\330\265\331\212\331\204\330\214 \330\253\331\205 \330\247\331\204\330\247\331\206\330\252\331\202\330\247\331\204 \330\245\331\204\331\211 \330\261\330\247\330\250\330\267 \330\252\330\255\331\205\331\212\331\204 \330\247\331\204\331\204\330\271\330\250\330\251. \330\243\331\206\330\247 \331\201\331\202\330\267 \330\243\330\263\330\252\330\267\331\212\330\271 \330\245\330\266\330\247\331\201\330\251 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \331\210\330\245\330\257\330\247\330\261\330\252\331\207\330\247 \331\205\331\206 \331\204\331\210\330\255\330\251 \330\252\330\255\331\203\331\205 \330\256\330\247\330\265\330\251.\n\n---\n\n# \330\247\331\204\330\252\331\202\331\206\331\212\330\247\330\252 \330\247\331\204\331\205\330\267\331\204\331\210\330\250\330\251\n\n## \331\202\330\247\330\271\330\257\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\210\330\247\331\204\331\205\330\265\330\247\330\257\331\202\330\251\n\n\330\247\330\263\330\252\330\256\330\257\331\205 Supabase \331\205\331\206 \330\243\330\254\331\204:\n\n* \331\202\330\247\330\271\330\257\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252.\n* \330\252\330\263\330\254\331\212\331\204 \330\257\330\256\331\210\331\204 \330\247\331\204\330\243\330\257\331\205\331\206.\n* \330\245\330\257\330\247\330\261\330\251 \330\247\331\204\331\205\330\263\330\252\330\256\330\257\331\205\331\212\331\206 \331\210\330\247\331\204\330\265\331\204\330\247\330\255\331\212\330\247\330\252.\n* \330\255\331\205\330\247\331\212\330\251 \331\204\331\210\330\255\330\251 \330\247\331\204\330\252\330\255\331\203\331\205.\n\n\330\247\330\263\330\252\330\256\330\257\331\205 Supabase Auth \331\205\330\271 \330\252\330\264\331\201\331\212\330\261 \331\203\331\204\331\205\330\247\330\252 \330\247\331\204\331\205\330\261\331\210\330\261 \330\250\330\247\331\204\330\267\330\261\331\212\331\202\330\251 \330\247\331\204\330\265\330\255\331\212\330\255\330\251 \331\210\330\271\330\257\331\205 \330\255\331\201\330\270 \331\203\331\204\331\205\330\247\330\252 \330\247\331\204\331\205\330\261\331\210\330\261 \331\203\331\206\330\265 \330\271\330\247\330\257\331\212.\n\n---\n\n# \330\247\331\204\330\252\330\256\330\262\331\212\331\206 \330\247\331\204\330\256\330\247\330\265 \330\250\330\247\331\204\330\265\331\210\330\261\n\n\330\247\330\263\330\252\330\256\330\257\331\205 Cloudinary API \330\247\331\204\330\260\331\212 \330\263\330\243\331\210\331\201\330\261\331\207 \331\204\331\203.\n\n\330\271\331\206\330\257 \330\245\330\266\330\247\331\201\330\251 \331\204\330\271\330\250\330\251 \330\254\330\257\331\212\330\257\330\251 \331\205\331\206 \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251:\n\n1. \330\243\330\261\331\201\330\271 \330\265\331\210\330\261\330\251 \330\247\331\204\331\204\330\271\330\250\330\251.\n2. \331\212\330\252\331\205 \330\245\330\261\330\263\330\247\331\204 \330\247\331\204\330\265\331\210\330\261\330\251 \330\252\331\204\331\202\330\247\330\246\331\212\331\213\330\247 \330\245\331\204\331\211 Cloudinary.\n3. \331\212\330\252\331\205 \330\247\331\204\330\255\330\265\331\210\331\204 \330\271\331\204\331\211 \330\261\330\247\330\250\330\267 \330\247\331\204\330\265\331\210\330\261\330\251.\n4. \331\212\330\252\331\205 \330\255\331\201\330\270 \330\261\330\247\330\250\330\267 \330\247\331\204\330\265\331\210\330\261\330\251 \331\201\331\212 \331\202\330\247\330\271\330\257\330\251 \330\250\331\212\330\247\331\206\330\247\330\252 Supabase.\n5. \331\212\330\252\331\205 \330\271\330\261\330\266 \330\247\331\204\330\265\331\210\330\261\330\251 \331\201\331\212 \330\247\331\204\331\205\331\210\331\202\330\271 \331\205\331\206 \330\261\330\247\330\250\330\267 Cloudinary.\n\n\331\204\330\247 \330\252\330\256\330\262\331\206 \330\247\331\204\330\265\331\210\330\261 \330\257\330\247\330\256\331\204 \330\247\330\263\330\252\330\266\330\247\331\201\330\251 \330\247\331\204\331\205\331\210\331\202\330\271.\n\n---\n\n# \331\204\331\210\330\255\330\251 \330\247\331\204\330\252\330\255\331\203\331\205 Admin Panel\n\n\330\245\331\206\330\264\330\247\330\241 \330\265\331\201\330\255\330\251 \330\256\330\247\330\265\330\251 \331\204\331\204\330\243\330\257\331\205\331\206 \331\201\331\202\330\267.\n\n\331\205\330\253\330\247\331\204:\n\n```\n/admin\n```\n\n\331\204\331\203\331\206 \331\212\330\254\330\250 \330\255\331\205\330\247\331\212\330\252\331\207\330\247 \330\250\330\247\331\204\331\203\330\247\331\205\331\204.\n\n\330\247\331\204\331\205\330\267\331\204\331\210\330\250:\n\n* \330\252\330\263\330\254\331\212\331\