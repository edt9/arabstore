          text: "            <strong>\330\267\330\261\331\212\331\202\330\251 \330\247\331\204\330\252\331\201\330\271\331\212\331\204:</strong> \330\247\330\260\331\207\330\250 \330\245\331\204\331\211 \331\204\331\210\330\255\330\251 \330\252\330\255\331\203\331\205 \330\263\331\210\330\250\330\247\330\250\331\212\330\263 (Supabase Dashboard) &gt; \330\247\330\260\331\207\330\250 \330\245\331\204\331\211 <strong>SQL Editor</strong> &gt; \330\247\331\204\330\265\331\202 \330\247\331\204\331\203\331\210\330\257 \330\247\331\204\330\263\330\247\330\250\331\202 &gt; \330\247\331\206\331\202\330\261 \330\271\331\204\331\211 <strong>Run</strong>. \330\253\331\205 \330\247\330\266\330\272\330\267 \330\271\331\204\331\211 \330\262\330\261 \"\330\252\330\255\330\257\331\212\330\253 \330\247\331\204\331\205\330\271\330\261\330\266\" \330\243\331\210 \331\202\331\205 \330\250\330\252\330\255\330\257\331\212\330\253 \330\247\331\204\330\265\331\201\330\255\330\251 \331\210\330\263\331\212\330\271\331\205\331\204 \330\247\331\204\330\247\330\252\330\265\330\247\331\204 \330\247\331\204\330\263\330\255\330\247\330\250\331\212 \331\205\330\250\330\247\330\264\330\261\330\251!"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
