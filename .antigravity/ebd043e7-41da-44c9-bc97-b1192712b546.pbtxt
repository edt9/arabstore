        lines {
          text: "CREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\255\330\260\331\201\" ON games FOR DELETE USING (true);`;"
