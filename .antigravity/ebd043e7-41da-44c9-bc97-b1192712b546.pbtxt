    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHHt6W8B2eeTh-4NfxhCc_5P1Lp0D3PcOfzlRie1RcxzKUsfc_HP5OOPm7U_RC86BpyQtTlJas5zRgTpjhcAWn6f8B75_C3Y3VxuV-qUW09PRQsHYng-TM="
      title: "nordcraft.com"
