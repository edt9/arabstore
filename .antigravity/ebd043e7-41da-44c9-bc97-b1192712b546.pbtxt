    instruction: "Apply the Professional Polish styling, header logo, side-by-side sidebar layout on desktop, dynamic featured hero section, and category chips to App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "  const isBrowsingMode = searchQuery === \"\" && selectedSubCategory === \"all\";\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 font-sans text-slate-800 dark:text-slate-100 flex flex-col transition-colors duration-300\">\n      \n      {/* ----------------- GLOBAL STICKY HEADER ----------------- */}\n      <header className=\"sticky top-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-100 dark:border-slate-800/80 shadow-sm transition-colors duration-300\">\n        <div className=\"max-w-7xl mx-auto px-4 md:px-8 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n          \n          {/* Logo & Brand */}\n          <div className=\"flex items-center justify-between gap-4\">\n            <div\n              onClick={() => {\n                setActiveTab(\"store\");\n                setStoreCategory(\"all\");\n                setSelectedSubCategory(\"all\");\n                setSearchQuery(\"\");\n              }}\n              className=\"flex items-center gap-2.5 cursor-pointer select-none group\"\n            >\n              <div className=\"relative w-10 h-10 bg-gradient-to-br from-blue-500 via-indigo-500 to-sky-400 rounded-2xl flex items-center justify-center shadow-md shadow-indigo-500/10 group-hover:shadow-indigo-500/30 transition-all duration-300\">\n                {/* Visual game controller overlay */}\n                <Smartphone className=\"w-5.5 h-5.5 text-white\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-1\">\n                  <span className=\"text-xl font-extrabold text-slate-900 dark:text-white font-sans tracking-tight\">\n                    \330\254\331\210\330\254\331\204 <span className=\"text-blue-600 dark:text-blue-400\">\330\250\331\204\330\247\331\212</span>\n                  </span>\n                  <span className=\"text-[10px] bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 px-1.5 py-0.5 rounded font-bold\">\n                    \330\247\331\204\330\271\330\261\330\250\331\212\n                  </span>\n                </div>\n                <span className=\"block text-[10px] text-slate-400 dark:text-slate-500 font-medium\">\n                  \331\205\330\252\330\254\330\261 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \331\210\330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \330\247\331\204\331\205\331\210\330\253\331\210\331\202\n                </span>\n              </div>\n            </div>\n\n            {/* Dark mode toggle & mobile admin view triggers */}\n            <div className=\"flex items-center gap-2 md:hidden\">\n              <button\n                onClick={toggleTheme}\n                className=\"p-2.5 bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-2xl text-slate-600 dark:text-slate-300 transition-colors\"\n                title=\"\330\252\330\272\331\212\331\212\330\261 \330\247\331\204\331\205\330\270\331\207\330\261\"\n              >\n                {theme === \"light\" ? <Moon className=\"w-5 h-5\" /> : <Sun className=\"w-5 h-5\" />}\n              </button>\n              <button\n                onClick={() => setActiveTab(activeTab === \"store\" ? \"admin\" : \"store\")}\n                className={`p-2.5 rounded-2xl transition-colors ${activeTab === \"admin\" ? \"bg-blue-600 text-white\" : \"bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300\"}`}\n                title=\"\331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251\"\n              >\n                <Shield className=\"w-5 h-5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Central Google Play Search Bar */}\n          {activeTab === \"store\" && (\n            <div className=\"relative flex-1 max-w-xl mx-auto w-full group\">\n              <span className=\"absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400 dark:text-slate-500 group-focus-within:text-blue-500 transition-colors\">\n                <Search className=\"w-5 h-5\" />\n              </span>\n              <input\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => {\n                  setSearchQuery(e.target.value);\n                  setSelectedSubCategory(\"all\"); // reset sub category when search starts\n                }}\n                placeholder=\"\330\247\330\250\330\255\330\253 \330\271\331\206 \330\243\331\204\330\271\330\247\330\250\330\214 \330\250\330\261\330\247\331\205\330\254 \331\210\330\252\330\267\330\250\331\212\331\202\330\247\330\252...\"\n                className=\"w-full pr-11 pl-4 py-3 text-sm text-slate-800 dark:text-slate-100 bg-slate-50 hover:bg-slate-100/70 focus:bg-white dark:bg-slate-800/80 dark:hover:bg-slate-800 dark:focus:bg-slate-900 border border-slate-100 hover:border-slate-200/80 focus:border-blue-500 dark:border-slate-700/60 dark:hover:border-slate-700 dark:focus:border-blue-400/80 rounded-2xl focus:outline-none focus:ring-4 focus:ring-blue-500/10 dark:focus:ring-blue-400/10 shadow-inner-sm transition-all\"\n              />\n              {searchQuery && (\n                <button\n                  onClick={() => setSearchQuery(\"\")}\n                  className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center text-xs font-semibold text-slate-400 hover:text-slate-600 transition-colors\"\n                >\n                  \331\205\330\263\330\255\n                </button>\n              )}\n            </div>\n          )}\n\n          {/* Desktop Right navigation / controls */}\n          <div className=\"hidden md:flex items-center gap-3\">\n            {/* Store Navigation Toggles */}\n            <div className=\"flex items-center bg-slate-50 dark:bg-slate-800 p-1 rounded-2xl border border-slate-100 dark:border-slate-800\">\n              <button\n                onClick={() => setActiveTab(\"store\")}\n                className={`px-5 py-2 rounded-xl text-sm font-bold transition-all ${activeTab === \"store\" ? \"bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-sm\" : \"text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white\"}`}\n              >\n                \330\252\330\265\331\201\330\255 \330\247\331\204\331\205\330\252\330\254\330\261\n              </button>\n              <button\n                onClick={() => setActiveTab(\"admin\")}\n                className={`px-5 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-1.5 ${activeTab === \"admin\" ? \"bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-sm\" : \"text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white\"}`}\n              >\n                <Shield className=\"w-4 h-4\" />\n                \331\204\331\210\330\255\330\251 \330\247\331\204\330\252\330\255\331\203\331\205\n              </button>\n            </div>\n\n            {/* Dark mode switch */}\n            <button\n              onClick={toggleTheme}\n              className=\"p-3 bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-2xl transition-colors border border-slate-100 dark:border-slate-800\"\n              title=\"\330\252\330\272\331\212\331\212\330\261 \330\247\331\204\331\205\330\270\331\207\330\261\"\n            >\n              {theme === \"light\" ? <Moon className=\"w-5 h-5\" /> : <Sun className=\"w-5 h-5\" />}\n            </button>\n          </div>\n\n        </div>\n      </header>\n\n      {/* ----------------- MAIN VIEW BODY CONTAINER ----------------- */}\n      <main className=\"flex-1 max-w-7xl mx-auto w-full px-4 md:px-8 py-8\">\n\n        {/* ----------------- 1. STORE VIEW ----------------- */}\n        {activeTab === \"store\" && (\n          <div className=\"space-y-8 animate-fade-in\">\n            \n            {/* Header Main Tabs Category select bar */}\n            <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-100 dark:border-slate-800/80 pb-4\">\n              <div className=\"flex items-center gap-3\">\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"all\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`px-5 py-2.5 rounded-full text-sm font-black transition-all flex items-center gap-2 ${storeCategory === \"all\" ? \"bg-blue-600 dark:bg-blue-500 text-white shadow-md shadow-blue-500/20\" : \"bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800/80\"}`}\n                >\n                  <LayoutGrid className=\"w-4.5 h-4.5\" />\n                  \330\247\331\204\331\203\331\204\n                </button>\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"games\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`px-5 py-2.5 rounded-full text-sm font-black transition-all flex items-center gap-2 ${storeCategory === \"games\" ? \"bg-blue-600 dark:bg-blue-500 text-white shadow-md shadow-blue-500/20\" : \"bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800/80\"}`}\n                >\n                  <Gamepad2 className=\"w-4.5 h-4.5\" />\n                  \330\247\331\204\330\243\331\204\330\271\330\247\330\250\n                </button>\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"apps\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`px-5 py-2.5 rounded-full text-sm font-black transition-all flex items-center gap-2 ${storeCategory === \"apps\" ? \"bg-blue-600 dark:bg-blue-500 text-white shadow-md shadow-blue-500/20\" : \"bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800/80\"}`}\n                >\n                  <AppWindow className=\"w-4.5 h-4.5\" />\n                  \330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252\n                </button>\n              </div>\n\n              {/* Refresh catalog indicator */}\n              <button\n                onClick={loadCatalog}\n                className=\"self-end sm:self-auto text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1\"\n                title=\"\330\252\330\255\330\257\331\212\330\253 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252\"\n              >\n                {loading ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <RefreshCw className=\"w-3.5 h-3.5\" />}\n                \330\252\330\255\330\257\331\212\330\253 \330\247\331\204\331\205\330\271\330\261\330\266\n              </button>\n            </div>\n\n            {/* Sub-categories Pills row */}\n            {getSubCategories().length > 1 && (\n              <div className=\"flex flex-wrap items-center gap-2 overflow-x-auto py-1\">\n                {getSubCategories().map((sub) => (\n                  <button\n                    key={sub}\n                    onClick={() => setSelectedSubCategory(sub)}\n                    className={`px-4 py-1.5 rounded-full text-xs font-bold transition-all ${selectedSubCategory === sub ? \"bg-slate-800 dark:bg-slate-100 text-white dark:text-slate-900\" : \"bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800\"}`}\n                  >\n                    {sub === \"all\" ? \"\330\254\331\205\331\212\330\271 \330\247\331\204\330\243\331\206\331\210\330\247\330\271\" : sub}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* Display list/grid logic */}\n            {loading ? (\n              <div className=\"py-24 text-center space-y-3\">\n                <Loader2 className=\"w-12 h-12 text-blue-500 animate-spin mx-auto\" />\n                <p className=\"text-slate-500 dark:text-slate-400 font-medium\">\330\254\330\247\330\261\331\212 \330\252\330\255\331\205\331\212\331\204 \330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\210\330\247\331\204\330\243\331\204\330\271\330\247\330\250...</p>\n              </div>\n            ) : filteredGames.length === 0 ? (\n              <div className=\"py-20 text-center bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80 rounded-3xl p-8 max-w-xl mx-auto space-y-4\">\n                <p className=\"text-3xl\">\360\237\224\215</p>\n                <h3 className=\"text-lg font-black text-slate-800 dark:text-slate-100\">\331\204\330\247 \330\252\331\210\330\254\330\257 \331\206\330\252\330\247\330\246\330\254 \331\205\330\267\330\247\330\250\331\202\330\251 \331\204\330\250\330\255\330\253\331\203</h3>\n                <p className=\"text-sm text-slate-500 leading-normal\">\n                  \331\212\330\261\330\254\331\211 \330\247\331\204\330\252\330\255\331\202\331\202 \331\205\331\206 \330\265\331\212\330\247\330\272\330\251 \330\247\331\204\331\203\331\204\331\205\330\247\330\252\330\214 \330\243\331\210 \330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\252\330\265\331\206\331\212\331\201\330\247\330\252 \330\243\330\256\330\261\331\211 \331\205\330\253\331\204 \"\330\247\331\204\330\243\331\204\330\271\330\247\330\250\" \330\243\331\210 \"\330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252\" \331\204\331\204\330\271\330\253\331\210\330\261 \330\271\331\204\331\211 \331\205\330\247 \330\252\330\250\330\255\330\253 \330\271\331\206\331\207.\n                </p>\n                <button\n                  onClick={() => {\n                    setSearchQuery(\"\");\n                    setSelectedSubCategory(\"all\");\n                    setStoreCategory(\"all\");\n                  }}\n                  className=\"px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl text-xs transition-colors\"\n                >\n                  \330\245\330\271\330\247\330\257\330\251 \330\252\330\271\331\212\331\212\331\206 \330\247\331\204\330\250\330\255\330\253 \331\210\330\247\331\204\331\201\331\204\330\252\330\261\330\251\n                </button>\n              </div>\n            ) : (\n              <LayoutGroup>\n                <div className=\"space-y-12\">\n                  {/* CASE 1: Standard browsing view (Shows split beautiful rows: Added lately, and Most downloaded) */}\n                  {isBrowsingMode ? (\n                    <>\n                      {/* Section 1: Last Added Games */}\n                      {lastAddedGames.length > 0 && (\n                        <div className=\"space-y-6\">\n                          <div className=\"flex items-center justify-between\">\n                            <h2 className=\"text-lg md:text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2\">\n                              <Clock className=\"w-5.5 h-5.5 text-blue-500\" />\n                              \330\243\330\255\330\257\330\253 \330\247\331\204\330\245\330\266\330\247\331\201\330\247\330\252 \331\210\330\247\331\204\330\252\330\255\330\257\331\212\330\253\330\247\330\252\n                            </h2>\n                            <span className=\"text-xs text-slate-400 dark:text-slate-500\">\330\252\331\205 \330\252\330\255\330\257\331\212\330\253\331\207\330\247 \331\205\330\244\330\256\330\261\330\247\331\213</span>\n                          </div>\n\n                          <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5\">\n                            {lastAddedGames.map((game) => (\n                              <GameCard\n                                key={game.id}\n                                game={game}\n                                onClick={() => setSelectedGame(game)}\n                              />\n                            ))}\n                          </div>\n                        </div>\n                      )}\n\n                      {/* Section 2: Most Downloaded games */}\n                      {mostDownloadedGames.length > 0 && (\n                        <div className=\"space-y-6\">\n                          <div className=\"flex items-center justify-between\">\n                            <h2 className=\"text-lg md:text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2\">\n                              <Flame className=\"w-5.5 h-5.5 text-amber-500 animate-pulse\" />\n                              \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \331\210\330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \330\247\331\204\330\243\331\203\330\253\330\261 \330\252\330\255\331\205\331\212\331\204\330\247\331\213\n                            </h2>\n                            <span className=\"text-xs text-slate-400 dark:text-slate-500\">\330\264\330\247\330\246\330\271\330\251 \331\210\331\205\331\210\330\265\331\211 \330\250\331\207\330\247</span>\n                          </div>\n\n                          <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5\">\n                            {mostDownloadedGames.map((game) => (\n                              <GameCard\n                                key={game.id}\n                                game={game}\n                                onClick={() => setSelectedGame(game)}\n                              />\n                            ))}\n                          </div>\n                        </div>\n                      )}\n                    </>\n                  ) : (\n                    /* CASE 2: Active searching or category pill filtering (shows single responsive grid) */\n                    <div className=\"space-y-6\">\n                      <div className=\"flex items-center justify-between\">\n                        <h2 className=\"text-lg md:text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2\">\n                          <Sparkles className=\"w-5.5 h-5.5 text-blue-500\" />\n                          \331\206\330\252\330\247\330\246\330\254 \330\247\331\204\330\252\330\265\331\201\331\212\330\251 \331\210\330\247\331\204\330\250\330\255\330\253 ({filteredGames.length} \331\206\330\252\331\212\330\254\330\251)\n                        </h2>\n                      </div>\n\n                      <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5\">\n                        {filteredGames.map((game) => (\n                          <GameCard\n                            key={game.id}\n                            game={game}\n                            onClick={() => setSelectedGame(game)}\n                          />\n                        ))}\n                      </div>\n                    </div>\n                  )}\n                </div>\n              </LayoutGroup>\n            )}\n          </div>\n        )}\n\n        {/* ----------------- 2. ADMIN CONTROL VIEW ----------------- */}\n        {activeTab === \"admin\" && (\n          <div className=\"animate-fade-in max-w-6xl mx-auto w-full\">\n            {isAdminAuthenticated ? (\n              <AdminPanel\n                adminEmail={adminEmail}\n                onLogout={handleAdminLogout}"
        replacement_content: "  const isBrowsingMode = searchQuery === \"\" && selectedSubCategory === \"all\";\n\n  // Dynamic Featured Hero Game or static fallback\n  const featuredGame = games.find((g) => (g.rating && parseFloat(g.rating as any) >= 4.5)) || games[0];\n\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] dark:bg-slate-950 font-sans text-slate-900 dark:text-slate-100 flex flex-col transition-colors duration-300\">\n      \n      {/* ----------------- GLOBAL STICKY HEADER ----------------- */}\n      <header className=\"sticky top-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-gray-200/80 dark:border-slate-800/80 shadow-sm transition-colors duration-300 h-16 flex items-center shrink-0\">\n        <div className=\"max-w-7xl mx-auto px-4 md:px-8 w-full flex items-center justify-between gap-4\">\n          \n          {/* Logo & Brand */}\n          <div className=\"flex items-center gap-8\">\n            <div\n              onClick={() => {\n                setActiveTab(\"store\");\n                setStoreCategory(\"all\");\n                setSelectedSubCategory(\"all\");\n                setSearchQuery(\"\");\n              }}\n              className=\"flex items-center gap-3 cursor-pointer select-none group\"\n            >\n              {/* Professional Polish Logo Badge */}\n              <div className=\"w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center shrink-0 shadow-md shadow-blue-500/10 group-hover:scale-105 transition-transform duration-200\">\n                <div className=\"w-4 h-4 bg-white transform rotate-45\"></div>\n              </div>\n              <div>\n                <span className=\"text-lg font-bold tracking-tight text-[#2563EB] dark:text-blue-400 font-sans flex items-center gap-1.5\">\n                  \331\205\330\252\330\254\330\261 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 <span className=\"text-xs bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full font-bold\">\330\250\331\204\330\247\331\212</span>\n                </span>\n              </div>\n            </div>\n\n            {/* Desktop main category navigation tabs */}\n            <nav className=\"hidden lg:flex gap-6 text-sm font-semibold text-gray-500 dark:text-gray-400\">\n              <button\n                onClick={() => {\n                  setActiveTab(\"store\");\n                  setStoreCategory(\"games\");\n                  setSelectedSubCategory(\"all\");\n                }}\n                className={`transition-colors py-2 border-b-2 hover:text-blue-600 ${\n                  activeTab === \"store\" && storeCategory === \"games\"\n                    ? \"text-blue-600 border-blue-600 dark:text-blue-400 dark:border-blue-400\"\n                    : \"border-transparent text-gray-500 hover:text-gray-900 dark:hover:text-white\"\n                }`}\n              >\n                \330\247\331\204\330\243\331\204\330\271\330\247\330\250\n              </button>\n              <button\n                onClick={() => {\n                  setActiveTab(\"store\");\n                  setStoreCategory(\"apps\");\n                  setSelectedSubCategory(\"all\");\n                }}\n                className={`transition-colors py-2 border-b-2 hover:text-blue-600 ${\n                  activeTab === \"store\" && storeCategory === \"apps\"\n                    ? \"text-blue-600 border-blue-600 dark:text-blue-400 dark:border-blue-400\"\n                    : \"border-transparent text-gray-500 hover:text-gray-900 dark:hover:text-white\"\n                }`}\n              >\n                \330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252\n              </button>\n              <button\n                onClick={() => {\n                  setActiveTab(\"store\");\n                  setStoreCategory(\"all\");\n                  setSelectedSubCategory(\"all\");\n                }}\n                className={`transition-colors py-2 border-b-2 hover:text-blue-600 ${\n                  activeTab === \"store\" && storeCategory === \"all\"\n                    ? \"text-blue-600 border-blue-600 dark:text-blue-400 dark:border-blue-400\"\n                    : \"border-transparent text-gray-500 hover:text-gray-900 dark:hover:text-white\"\n                }`}\n              >\n                \330\247\331\204\331\203\331\204\n              </button>\n            </nav>\n          </div>\n\n          {/* Central Google Play Search Bar */}\n          {activeTab === \"store\" && (\n            <div className=\"relative flex-1 max-w-xl mx-auto w-full group\">\n              <span className=\"absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400 dark:text-gray-500 group-focus-within:text-blue-500 transition-colors\">\n                <Search className=\"w-5 h-5\" />\n              </span>\n              <input\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => {\n                  setSearchQuery(e.target.value);\n                  setSelectedSubCategory(\"all\");\n                }}\n                placeholder=\"\330\247\330\250\330\255\330\253 \330\271\331\206 \330\243\331\204\330\271\330\247\330\250\330\214 \330\250\330\261\330\247\331\205\330\254 \331\210\330\252\330\267\330\250\331\212\331\202\330\247\330\252...\"\n                className=\"w-full bg-gray-100 hover:bg-gray-200/50 focus:bg-white dark:bg-slate-800/80 dark:hover:bg-slate-800 dark:focus:bg-slate-900 border-none rounded-full py-2 pr-12 pl-10 text-sm text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:outline-none transition-all shadow-sm\"\n              />\n              {searchQuery && (\n                <button\n                  onClick={() => setSearchQuery(\"\")}\n                  className=\"absolute inset-y-0 left-3 flex items-center text-xs font-bold text-slate-400 hover:text-slate-600 transition-colors\"\n                >\n                  \331\205\330\263\330\255\n                </button>\n              )}\n            </div>\n          )}\n\n          {/* Desktop Right navigation / controls */}\n          <div className=\"flex items-center gap-4\">\n            {/* Quick access tabs for Admin / Store */}\n            <div className=\"hidden sm:flex items-center gap-1.5\">\n              <button\n                onClick={() => setActiveTab(activeTab === \"store\" ? \"admin\" : \"store\")}\n                className={`px-4 py-2 rounded-full text-xs font-bold transition-all border ${\n                  activeTab === \"admin\"\n                    ? \"bg-blue-600 text-white border-blue-600\"\n                    : \"bg-white dark:bg-slate-800 text-gray-600 dark:text-gray-300 border-gray-200/80 dark:border-slate-800 hover:bg-gray-50\"\n                }`}\n              >\n                {activeTab === \"admin\" ? \"\330\247\331\204\330\271\331\210\330\257\330\251 \331\204\331\204\331\205\330\252\330\254\330\261\" : \"\331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251\"}\n              </button>\n            </div>\n\n            {/* Dark mode toggle */}\n            <button\n              onClick={toggleTheme}\n              className=\"p-2 text-gray-500 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-full transition-colors\"\n              title=\"\330\252\330\272\331\212\331\212\330\261 \330\247\331\204\331\205\330\270\331\207\330\261\"\n            >\n              {theme === \"light\" ? <Moon className=\"w-5 h-5\" /> : <Sun className=\"w-5 h-5\" />}\n            </button>\n\n            {/* Simulated user avatar matching template */}\n            <div className=\"w-9 h-9 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 border-2 border-white dark:border-slate-800 shadow-sm shrink-0 cursor-pointer\" onClick={() => setActiveTab(\"admin\")} title={isAdminAuthenticated ? `\331\205\330\263\330\254\331\204 \331\203\331\205\330\263\330\244\331\210\331\204: ${adminEmail}` : \"\330\250\331\210\330\247\330\250\330\251 \330\247\331\204\331\205\330\263\330\244\331\210\331\204\"}></div>\n          </div>\n\n        </div>\n      </header>\n\n      {/* ----------------- MAIN VIEW BODY CONTAINER ----------------- */}\n      <main className=\"flex-1 max-w-7xl mx-auto w-full px-4 md:px-8 py-8\">\n\n        {/* ----------------- 1. STORE VIEW ----------------- */}\n        {activeTab === \"store\" && (\n          <div className=\"space-y-8 animate-fade-in\">\n            \n            {/* Horizontal Categories selector on mobile (always visible for mobile comfort, but hidden when desktop sidebar displays) */}\n            <div className=\"lg:hidden flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-100 dark:border-slate-800/80 pb-4\">\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"all\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`px-4 py-2 rounded-full text-xs font-black transition-all flex items-center gap-1.5 ${\n                    storeCategory === \"all\"\n                      ? \"bg-blue-600 text-white shadow-md\"\n                      : \"bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-gray-100 dark:border-slate-800\"\n                  }`}\n                >\n                  <LayoutGrid className=\"w-4 h-4\" />\n                  \330\247\331\204\331\203\331\204\n                </button>\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"games\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`px-4 py-2 rounded-full text-xs font-black transition-all flex items-center gap-1.5 ${\n                    storeCategory === \"games\"\n                      ? \"bg-blue-600 text-white shadow-md\"\n                      : \"bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-gray-100 dark:border-slate-800\"\n                  }`}\n                >\n                  <Gamepad2 className=\"w-4 h-4\" />\n                  \330\247\331\204\330\243\331\204\330\271\330\247\330\250\n                </button>\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"apps\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`px-4 py-2 rounded-full text-xs font-black transition-all flex items-center gap-1.5 ${\n                    storeCategory === \"apps\"\n                      ? \"bg-blue-600 text-white shadow-md\"\n                      : \"bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-gray-100 dark:border-slate-800\"\n                  }`}\n                >\n                  <AppWindow className=\"w-4 h-4\" />\n                  \330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252\n                </button>\n              </div>\n\n              {/* Refresh catalog indicator */}\n              <button\n                onClick={loadCatalog}\n                className=\"text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1\"\n              >\n                {loading ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <RefreshCw className=\"w-3.5 h-3.5\" />}\n                \330\252\330\255\330\257\331\212\330\253 \330\247\331\204\331\205\330\271\330\261\330\266\n              </button>\n            </div>\n\n            {/* Mobile Sub-categories scrollbar */}\n            {lgCheckSubCategories(getSubCategories()) && (\n              <div className=\"lg:hidden flex items-center gap-2 overflow-x-auto py-1 no-scrollbar\">\n                {getSubCategories().map((sub) => (\n                  <button\n                    key={sub}\n                    onClick={() => setSelectedSubCategory(sub)}\n                    className={`px-3.5 py-1.5 rounded-full text-xs font-bold transition-all whitespace-nowrap shrink-0 ${\n                      selectedSubCategory === sub\n                        ? \"bg-slate-800 dark:bg-slate-100 text-white dark:text-slate-900\"\n                        : \"bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:bg-slate-100 border border-gray-100 dark:border-slate-800\"\n                    }`}\n                  >\n                    {sub === \"all\" ? \"\330\254\331\205\331\212\330\271 \330\247\331\204\330\243\331\206\331\210\330\247\330\271\" : sub}\n                  </button>\n                ))}\n              </div>\n            )}\n\n            {/* SPLIT SIDEBAR & CONTENT LAYOUT */}\n            <div className=\"flex flex-col lg:flex-row gap-8 items-start\">\n              \n              {/* Desktop Sidebar */}\n              <aside className=\"hidden lg:flex w-60 bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 p-6 flex-col gap-2 rounded-3xl shrink-0 sticky top-24 shadow-sm\">\n                <div className=\"text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-2 pr-2\">\330\247\331\204\330\247\331\203\330\252\330\264\330\247\331\201</div>\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"all\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`flex items-center gap-3 px-4 py-2.5 rounded-xl font-bold text-sm text-right w-full transition-all ${\n                    storeCategory === \"all\" && selectedSubCategory === \"all\"\n                      ? \"bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-400\"\n                      : \"text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-800/50\"\n                  }`}\n                >\n                  <span className=\"text-lg\">\360\237\216\256</span> \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \330\247\331\204\331\205\331\205\331\212\330\262\330\251\n                </button>\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"games\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`flex items-center gap-3 px-4 py-2.5 rounded-xl font-bold text-sm text-right w-full transition-all ${\n                    storeCategory === \"games\" && selectedSubCategory === \"all\"\n                      ? \"bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-400\"\n                      : \"text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-800/50\"\n                  }`}\n                >\n                  <span className=\"text-lg\">\360\237\223\210</span> \330\247\331\204\330\243\331\203\330\253\330\261 \330\261\331\210\330\247\330\254\330\247\331\213\n                </button>\n                <button\n                  onClick={() => {\n                    setStoreCategory(\"apps\");\n                    setSelectedSubCategory(\"all\");\n                  }}\n                  className={`flex items-center gap-3 px-4 py-2.5 rounded-xl font-bold text-sm text-right w-full transition-all ${\n                    storeCategory === \"apps\" && selectedSubCategory === \"all\"\n                      ? \"bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-400\"\n                      : \"text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-800/50\"\n                  }`}\n                >\n                  <span className=\"text-lg\">\360\237\206\225</span> \330\243\330\255\330\257\330\253 \330\247\331\204\330\245\330\265\330\257\330\247\330\261\330\247\330\252\n                </button>\n\n                <div className=\"h-px bg-gray-100 dark:bg-slate-800 my-4\"></div>\n                <div className=\"text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-2 pr-2\">\330\252\330\265\331\201\330\255 \330\247\331\204\331\201\330\246\330\247\330\252</div>\n                \n                <div className=\"flex flex-col gap-1 max-h-56 overflow-y-auto pr-1\">\n                  {getSubCategories().map((sub) => (\n                    <button\n                      key={sub}\n                      onClick={() => setSelectedSubCategory(sub)}\n                      className={`text-right px-4 py-2 text-xs font-bold rounded-xl transition-all ${\n                        selectedSubCategory === sub\n                          ? \"bg-blue-50/80 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 font-extrabold\"\n                          : \"text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800/40\"\n                      }`}\n                    >\n                      {sub === \"all\" ? \"\330\254\331\205\331\212\330\271 \330\247\331\204\331\201\330\246\330\247\330\252\" : sub}\n                    </button>\n                  ))}\n                </div>\n\n                <div className=\"mt-8 pt-4 border-t border-gray-100 dark:border-slate-800\">\n                  <button\n                    onClick={() => setActiveTab(\"admin\")}\n                    className=\"flex items-center gap-3 px-4 py-2.5 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-800 rounded-xl font-medium border border-gray-100 dark:border-slate-800 shadow-sm bg-white dark:bg-slate-900 w-full text-right\"\n                  >\n                    <span className=\"text-lg\">\342\232\231\357\270\217</span> \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251\n                  </button>\n                </div>\n              </aside>\n\n              {/* Main Contents Grid panel */}\n              <div className=\"flex-1 w-full space-y-8\">\n                \n                {/* Featured Hero Section */}\n                {isBrowsingMode && (\n                  <section className=\"relative h-64 md:h-72 rounded-3xl overflow-hidden shrink-0 shadow-lg border border-gray-100 dark:border-slate-800\">\n                    <div className=\"absolute inset-0 bg-gradient-to-l from-slate-950/90 via-slate-950/50 to-transparent z-10\"></div>\n                    <div\n                      className=\"absolute inset-0 bg-cover bg-center\"\n                      style={{\n                        backgroundImage: `url(\'${\n                          featuredGame\n                            ? featuredGame.image_url\n                            : \"https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=1000\"\n                        }\')`\n                      }}\n                    ></div>\n                    <div className=\"relative z-20 h-full flex flex-col justify-center px-8 md:px-12 text-white max-w-xl\">\n                      <span className=\"bg-blue-600 text-[10px] md:text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full w-fit mb-3\">\n                        {featuredGame && featuredGame.category === \"apps\" ? \"\330\252\330\267\330\250\331\212\331\202 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\" : \"\331\204\330\271\330\250\330\251 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\"}\n                      </span>\n                      <h1 className=\"text-2xl md:text-4xl font-black mb-2 text-white leading-tight\">\n                        {featuredGame ? featuredGame.name : \"\330\243\330\263\330\267\331\210\330\261\330\251 \330\247\331\204\331\201\330\266\330\247\330\241: \330\247\331\204\331\207\330\254\331\210\331\205 \330\247\331\204\330\243\330\256\331\212\330\261\"}\n                      </h1>\n                      <p className=\"text-gray-200 text-xs md:text-sm mb-6 leading-relaxed line-clamp-2\">\n                        {featuredGame ? featuredGame.description : \"\330\256\330\266 \331\205\330\271\330\247\330\261\331\203 \331\205\331\204\330\255\331\205\331\212\330\251 \331\201\331\212 \330\243\330\271\331\205\330\247\331\202 \330\247\331\204\331\205\330\254\330\261\330\251. \330\261\330\263\331\210\331\205\330\247\330\252 \331\205\330\260\331\207\331\204\330\251 \331\210\330\252\330\254\330\261\330\250\330\251 \331\204\330\271\330\250 \330\272\331\212\330\261 \331\205\330\263\330\250\331\210\331\202\330\251 \330\247\331\204\330\242\331\206 \330\271\331\204\331\211 \330\254\331\210\330\247\331\204\331\203.\"}\n                      </p>\n                      <div className=\"flex gap-4\">\n                        <button\n                          onClick={() => {\n                            if (featuredGame) {\n                              setSelectedGame(featuredGame);\n                            } else {\n                              alert(\"\331\212\330\261\330\254\331\211 \330\245\330\266\330\247\331\201\330\251 \330\243\331\204\330\271\330\247\330\250 \331\210\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\205\331\206 \331\204\331\210\330\255\330\251 \330\247\331\204\330\252\330\255\331\203\331\205 \331\204\330\252\331\201\330\271\331\212\331\204 \330\247\331\204\331\205\330\252\330\254\330\261 \330\250\330\247\331\204\331\203\330\247\331\205\331\204!\");\n                            }\n                          }}\n                          className=\"bg-white text-black px-6 py-2.5 rounded-xl text-xs md:text-sm font-bold hover:bg-gray-100 transition-colors shadow-lg\"\n                        >\n                          \330\252\330\253\330\250\331\212\330\252 \330\247\331\204\330\242\331\206\n                        </button>\n                        <button\n                          onClick={() => {\n                            if (featuredGame) {\n                              setSelectedGame(featuredGame);\n                            }\n                          }}\n                          className=\"bg-white/20 backdrop-blur-md text-white px-6 py-2.5 rounded-xl text-xs md:text-sm font-bold hover:bg-white/30 transition-colors border border-white/30\"\n                        >\n                          \330\247\331\204\330\252\331\201\330\247\330\265\331\212\331\204\n                        </button>\n                      </div>\n                    </div>\n                  </section>\n                )}\n\n                {/* Display list/grid logic */}\n                {loading ? (\n                  <div className=\"py-24 text-center space-y-3\">\n                    <Loader2 className=\"w-12 h-12 text-blue-500 animate-spin mx-auto\" />\n                    <p className=\"text-slate-500 dark:text-slate-400 font-medium\">\330\254\330\247\330\261\331\212 \330\252\330\255\331\205\331\212\331\204 \330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\210\330\247\331\204\330\243\331\204\330\271\330\247\330\250...</p>\n                  </div>\n                ) : filteredGames.length === 0 ? (\n                  <div className=\"py-16 text-center bg-white dark:bg-slate-900 border border-gray-100 dark:border-slate-800/80 rounded-3xl p-8 max-w-xl mx-auto space-y-4\">\n                    <p className=\"text-3xl\">\360\237\224\215</p>\n                    <h3 className=\"text-lg font-black text-slate-800 dark:text-slate-100\">\331\204\330\247 \330\252\331\210\330\254\330\257 \331\206\330\252\330\247\330\246\330\254 \331\205\330\267\330\247\330\250\331\202\330\251 \331\204\330\250\330\255\330\253\331\203</h3>\n                    <p className=\"text-sm text-slate-500 leading-normal\">\n                      \331\212\330\261\330\254\331\211 \330\247\331\204\330\252\330\255\331\202\331\202 \331\205\331\206 \330\265\331\212\330\247\330\272\330\251 \330\247\331\204\331\203\331\204\331\205\330\247\330\252\330\214 \330\243\331\210 \330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\252\330\265\331\206\331\212\331\201\330\247\330\252 \330\243\330\256\330\261\331\211 \331\204\331\204\330\271\330\253\331\210\330\261 \330\271\331\204\331\211 \331\205\330\247 \330\252\330\250\330\255\330\253 \330\271\331\206\331\207.\n                    </p>\n                    <button\n                      onClick={() => {\n                        setSearchQuery(\"\");\n                        setSelectedSubCategory(\"all\");\n                        setStoreCategory(\"all\");\n                      }}\n                      className=\"px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl text-xs transition-colors\"\n                    >\n                      \330\245\330\271\330\247\330\257\330\251 \330\252\330\271\331\212\331\212\331\206 \330\247\331\204\330\250\330\255\330\253 \331\210\330\247\331\204\331\201\331\204\330\252\330\261\330\251\n                    </button>\n                  </div>\n                ) : (\n                  <LayoutGroup>\n                    <div className=\"space-y-10\">\n                      {/* CASE 1: Standard browsing view */}\n                      {isBrowsingMode ? (\n                        <>\n                          {/* Section 1: Last Added Games */}\n                          {lastAddedGames.length > 0 && (\n                            <div className=\"space-y-4\">\n                              <div className=\"flex items-center justify-between\">\n                                <h2 className=\"text-lg font-bold text-gray-800 dark:text-white flex items-center gap-2\">\n                                  <Clock className=\"w-5 h-5 text-blue-500\" />\n                                  \330\243\330\255\330\257\330\253 \330\247\331\204\330\245\330\266\330\247\331\201\330\247\330\252 \331\210\330\247\331\204\330\252\330\255\330\257\331\212\330\253\330\247\330\252\n                                </h2>\n                                <span className=\"text-xs text-slate-400\">\331\205\330\266\330\247\331\201 \330\255\330\257\331\212\330\253\330\247\331\213</span>\n                              </div>\n\n                              <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-6\">\n                                {lastAddedGames.map((game) => (\n                                  <GameCard\n                                    key={game.id}\n                                    game={game}\n                                    onClick={() => setSelectedGame(game)}\n                                  />\n                                ))}\n                              </div>\n                            </div>\n                          )}\n\n                          {/* Section 2: Most Downloaded games */}\n                          {mostDownloadedGames.length > 0 && (\n                            <div className=\"space-y-4\">\n                              <div className=\"flex items-center justify-between\">\n                                <h2 className=\"text-lg font-bold text-gray-800 dark:text-white flex items-center gap-2\">\n                                  <Flame className=\"w-5 h-5 text-amber-500 animate-pulse\" />\n                                  \330\247\331\204\330\243\331\203\330\253\330\261 \330\252\331\206\330\262\331\212\331\204\330\247\331\213 \331\210\330\264\330\271\330\250\331\212\330\251\n                                </h2>\n                                <span className=\"text-xs text-slate-400\">\330\264\330\247\330\246\330\271 \331\210\331\205\331\210\330\265\331\211 \330\250\331\207</span>\n                              </div>\n\n                              <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-6\">\n                                {mostDownloadedGames.map((game) => (\n                                  <GameCard\n                                    key={game.id}\n                                    game={game}\n                                    onClick={() => setSelectedGame(game)}\n                                  />\n                                ))}\n                              </div>\n                            </div>\n                          )}\n                        </>\n                      ) : (\n                        /* CASE 2: Active searching or category pill filtering */\n                        <div className=\"space-y-4\">\n                          <div className=\"flex items-center justify-between\">\n                            <h2 className=\"text-lg font-bold text-gray-800 dark:text-white flex items-center gap-2\">\n                              <Sparkles className=\"w-5 h-5 text-blue-500\" />\n                              \331\206\330\252\330\247\330\246\330\254 \330\247\331\204\330\252\330\265\331\201\331\212\330\251 \331\210\330\247\331\204\330\250\330\255\330\253 ({filteredGames.length} \331\206\330\252\331\212\330\254\330\251)\n                            </h2>\n                          </div>\n\n                          <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-6\">\n                            {filteredGames.map((game) => (\n                              <GameCard\n                                key={game.id}\n                                game={game}\n                                onClick={() => setSelectedGame(game)}\n                              />\n                            ))}\n                          </div>\n                        </div>\n                      )}\n\n                      {/* Custom Category Chips Section matching prompt */}\n                      <section className=\"flex flex-col gap-4 pt-6 border-t border-gray-100 dark:border-slate-800/80\">\n                        <h2 className=\"text-lg font-bold text-gray-800 dark:text-white\">\330\252\330\265\331\201\330\255 \330\255\330\263\330\250 \330\247\331\204\331\206\331\210\330\271</h2>\n                        <div className=\"flex flex-wrap gap-3\">\n                          <button\n                            onClick={() => {\n                              setSelectedSubCategory(\"\330\243\331\204\330\271\330\247\330\250 \330\243\331\203\330\264\331\206\");\n                              setActiveTab(\"store\");\n                            }}\n                            className=\"px-6 py-2 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-full text-xs font-semibold hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all shadow-sm cursor-pointer\"\n                          >\n                            \330\243\331\204\330\271\330\247\330\250 \330\247\331\204\330\243\331\203\330\264\331\206 \331\210\330\247\331\204\331\202\330\252\330\247\331\204\n                          </button>\n                          <button\n                            onClick={() => {\n                              setSelectedSubCategory(\"\330\243\331\204\330\271\330\247\330\250 \330\260\331\203\330\247\330\241\");\n                              setActiveTab(\"store\");\n                            }}\n                            className=\"px-6 py-2 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-full text-xs font-semibold hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all shadow-sm cursor-pointer\"\n                          >\n                            \330\243\331\204\330\271\330\247\330\250 \330\247\331\204\330\260\331\203\330\247\330\241 \331\210\330\247\331\204\330\243\331\204\330\272\330\247\330\262\n                          </button>\n                          <button\n                            onClick={() => {\n                              setSelectedSubCategory(\"\330\261\331\212\330\247\330\266\330\251\");\n                              setActiveTab(\"store\");\n                            }}\n                            className=\"px-6 py-2 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-full text-xs font-semibold hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all shadow-sm cursor-pointer\"\n                          >\n                            \330\261\331\212\330\247\330\266\330\251 \331\210\330\263\330\250\330\247\331\202 \331\206\331\212\330\252\330\261\331\210\n                          </button>\n                          <button\n                            onClick={() => {\n                              setSelectedSubCategory(\"\330\243\330\257\331\210\330\247\330\252\");\n                              setActiveTab(\"store\");\n                            }}\n                            className=\"px-6 py-2 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-full text-xs font-semibold hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all shadow-sm cursor-pointer\"\n                          >\n                            \330\243\330\257\331\210\330\247\330\252 \331\210\330\245\331\206\330\252\330\247\330\254\331\212\330\251\n                          </button>\n                          <button\n                            onClick={() => {\n                              setSelectedSubCategory(\"\330\252\330\261\331\201\331\212\331\207\");\n                              setActiveTab(\"store\");\n                            }}\n                            className=\"px-6 py-2 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-full text-xs font-semibold hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all shadow-sm cursor-pointer\"\n                          >\n                            \331\205\331\206\330\265\330\247\330\252 \330\252\330\261\331\201\331\212\331\207 \331\210\330\252\331\210\330\247\330\265\331\204\n                          </button>\n                        </div>\n                      </section>\n\n                    </div>\n                  </LayoutGroup>\n                )}\n\n              </div>\n\n            </div>\n          </div>\n        )}\n\n        {/* ----------------- 2. ADMIN CONTROL VIEW ----------------- */}\n        {activeTab === \"admin\" && (\n          <div className=\"animate-fade-in max-w-6xl mx-auto w-full\">\n            {isAdminAuthenticated ? (\n              <AdminPanel\n                adminEmail={adminEmail}\n                onLogout={handleAdminLogout}"
