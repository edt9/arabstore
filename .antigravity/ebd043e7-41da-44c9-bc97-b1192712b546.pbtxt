\330\271\331\212\331\204 \330\263\331\212\330\247\330\263\330\247\330\252 \330\247\331\204\330\243\331\205\330\247\331\206 \331\210\330\247\331\204\330\255\331\205\330\247\331\212\330\251 (RLS).\n\n---\n\n### \360\237\232\200 \330\256\330\267\331\210\330\252\331\203 \330\247\331\204\330\252\330\247\331\204\331\212\330\251 \331\204\330\261\330\250\330\267 \330\263\331\210\330\250\330\247\330\250\331\212\330\263 (Supabase) \330\250\330\247\331\204\331\203\330\247\331\205\331\204:\n\331\204\330\252\331\201\330\271\331\212\331\204 \330\247\331\204\330\252\330\256\330\262\331\212\331\206 \330\247\331\204\330\263\330\255\330\247\330\250\331\212 \330\247\331\204\330\257\330\247\330\246\331\205 \330\271\330\250\330\261 Supabase \331\210\331\205\330\262\330\247\331\205\331\206\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\271\330\250\330\261 \330\247\331\204\330\263\330\255\330\247\330\250\330\251\330\214 \331\205\330\247 \330\271\331\204\331\212\331\203 \330\263\331\210\331\211 \330\247\330\252\330\250\330\247\330\271 \330\247\331\204\330\256\330\267\331\210\330\247\330\252 \330\247\331\204\330\250\330\263\331\212\330\267\330\251 \330\247\331\204\330\252\330\247\331\204\331\212\330\251:\n1. \330\247\330\260\331\207\330\250 \330\245\331\204\331\211 \330\255\330\263\330\247\330\250\331\203 \331\201\331\212 **Supabase Dashboard** \331\210\330\247\331\201\330\252\330\255 \331\205\330\264\330\261\331\210\330\271\331\203.\n2. \331\205\331\206 \330\247\331\204\331\202\330\247\330\246\331\205\330\251 \330\247\331\204\330\254\330\247\331\206\330\250\331\212\330\251\330\214 \330\247\330\256\330\252\330\261 **SQL Editor** \330\253\331\205 \330\247\330\266\330\272\330\267 \330\271\331\204\331\211 **New query**.\n3. \330\252\331\210\330\254\331\207 \330\245\331\204\331\211 **\331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251** \331\201\331\212 \330\252\330\267\330\250\331\212\331\202\331\203 \331\210\330\247\331\206\