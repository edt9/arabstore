8a05e?auto=format&fit=crop&q=80&w=1000\')] bg-cover bg-center\\\"></div>\\n        <div class=\\\"relative z-20 h-full flex flex-col justify-center px-12 text-white\\\">\\n          <span class=\\\"bg-blue-600 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full w-fit mb-4\\\">\331\204\330\271\330\250\330\251 \330\247\331\204\330\243\330\263\330\250\331\210\330\271</span>\\n          <h1 class=\\\"text-4xl font-black mb-2\\\">\330\243\330\263\330\267\331\210\330\261\330\251 \330\247\331\204\331\201\330\266\330\247\330\241: \330\247\331\204\331\207\330\254\331\210\331\205 \330\247\331\204\330\243\330\256\331\212\330\261</h1>\\n          <p class=\\\"text-gray-200 max-w-md mb-6 leading-relaxed\\\">\330\256\330\266 \331\205\330\271\330\247\330\261\331\203 \331\205\331\204\330\255\331\205\331\212\330\251 \331\201\331\212 \330\243\330\271\331\205\330\247\331\202 \330\247\331\204\331\205\330\254\330\261\330\251. \330\261\330\263\331\210\331\205\330\247\330\252 \331\205\330\260\331\207\331\204\330\251 \331\210\330\252\330\254\330\261\330\250\330\251 \331\204\330\271\330\250 \330\272\331\212\330\261 \331\205\330\263\330\250\331\210\331\202\330\251 \330\247\331\204\330\242\331\206 \330\271\331\204\331\211 \330\254\331\210\330\247\331\204\331\203.</p>\\n          <div class=\\\"flex gap-4\\\">\\n            <button class=\\\"bg-white text-black px-8 py-3 rounded-xl font-bold hover:bg-gray-100 transition-colors shadow-lg\\\">\330\252\330\253\330\250\331\212\330\252 \330\247\331\204\330\242\331\206</button>\\n            <button class=\\\"bg-white/20 backdrop-blur-md text-white px-8 py-3 rounded-xl font-bold hover:bg-white/30 transition-colors border border-white/30\\\">\330\247\331\204\330\252\331\201\330\247\330\265\331\212\331\204</button>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <!-- App Grid Section -->\\n      <section class=\\\"flex flex-col gap-4\\\">\\n        <div class=\\\"flex justify-between items-center\\\">\\n          <h2 class=\\\"text-xl font-bold text-gray-800\\\">\330\243\331\204\330\271\330\247\330\250 \331\205\331\202\330\252\330\261\330\255\330\251 \331\204\331\203</h2>\\n          <a href=\\\"#\\\" class=\\\"text-blue-600 text-sm font-semibold hover:underline\\\">\330\271\330\261\330\266 \330\247\331\204\331\203\331\204</a>\\n        </div>\\n        <div class=\\\"grid grid-cols-4 gap-6\\\">\\n          <!-- Card 1 -->\\n          <div class=\\\"bg-white p-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow cursor-pointer flex flex-col gap-3 group\\\">\\n            <div class=\\\"aspect-square rounded-xl bg-blue-100 overflow-hidden\\\">\\n               <img src=\\\"https://images.unsplash.com/photo-1550745679-5652175bdb7b?auto=format&fit=crop&q=80&w=200\\\" class=\\\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\\\">\\n            </div>\\n            <div>\\n              <h3 class=\\\"font-bold text-[15px] truncate mb-0.5\\\">\331\205\330\272\330\247\331\205\330\261\330\251 \330\247\331\204\330\243\331\204\330\272\330\247\330\262</h3>\\n              <p class=\\\"text-xs text-gray-500 mb-2\\\">\330\247\331\204\330\245\330\265\330\257\330\247\330\261 2.4.1 \342\200\242 145 MB</p>\\n              <div class=\\\"flex items-center justify-between\\\">\\n                <span class=\\\"text-xs font-bold bg-gray-50 px-2 py-1 rounded border border-gray-100\\\">4.8 \342\230\205</span>\\n                <span class=\\\"text-blue-600 text-xs font-bold\\\">\331\205\330\254\330\247\331\206\330\247\331\213</span>\\n              </div>\\n            </div>\\n          </div>\\n          <!-- Card 2 -->\\n          <div class=\\\"bg-white p-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow cursor-pointer flex flex-col gap-3 group\\\">\\n            <div class=\\\"aspect-square rounded-xl bg-green-100 overflow-hidden\\\">\\n               <img src=\\\"https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&q=80&w=200\\\" class=\\\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\\\">\\n            </div>\\n            <div>\\n              <h3 class=\\\"font-bold text-[15px] truncate mb-0.5\\\">\330\263\330\250\330\247\331\202 \330\247\331\204\331\206\331\212\330\252\330\261\331\210</h3>\\n              <p class=\\\"text-xs text-gray-500 mb-2\\\">\330\247\331\204\330\245\330\265\330\257\330\247\330\261 1.0.5 \342\200\242 890 MB</p>\\n              <div class=\\\"flex items-center justify-between\\\">\\n                <span class=\\\"text-xs font-bold bg-gray-50 px-2 py-1 rounded border border-gray-100\\\">4.5 \342\230\205</span>\\n                <span class=\\\"text-blue-600 text-xs font-bold text-left\\\">\330\252\330\253\330\250\331\212\330\252</span>\\n              </div>\\n            </div>\\n          </div>\\n          <!-- Card 3 -->\\n          <div class=\\\"bg-white p-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow cursor-pointer flex flex-col gap-3 group\\\">\\n            <div class=\\\"aspect-square rounded-xl bg-yellow-100 overflow-hidden\\\">\\n               <img src=\\\"https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=200\\\" class=\\\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\\\">\\n            </div>\\n            <div>\\n              <h3 class=\\\"font-bold text-[15px] truncate mb-0.5\\\">\331\205\331\205\331\204\331\203\330\251 \330\247\331\204\330\243\330\263\330\247\330\267\331\212\330\261</h3>\\n              <p class=\\\"text-xs text-gray-500 mb-2\\\">\330\247\331\204\330\245\330\265\330\257\330\247\330\261 3.2.0 \342\200\242 1.2 GB</p>\\n              <div class=\\\"flex items-center justify-between\\\">\\n                <span class=\\\"text-xs font-bold bg-gray-50 px-2 py-1 rounded border border-gray-100\\\">4.9 \342\230\205</span>\\n                <span class=\\\"text-blue-600 text-xs font-bold\\\">\330\252\330\253\330\250\331\212\330\252</span>\\n              </div>\\n            </div>\\n          </div>\\n          <!-- Card 4 -->\\n          <div class=\\\"bg-white p-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow cursor-pointer flex flex-col gap-3 group\\\">\\n            <div class=\\\"aspect-square rounded-xl bg-red-100 overflow-hidden\\\">\\n               <img src=\\\"https://images.unsplash.com/photo-1593305841991-05c297ba4575?auto=format&fit=crop&q=80&w=200\\\" class=\\\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\\\">\\n            </div>\\n            <div>\\n              <h3 class=\\\"font-bold text-[15px] truncate mb-0.5\\\">\331\202\331\206\330\247\330\265 \330\247\331\204\331\205\330\257\331\212\331\206\330\251</h3>\\n              <p class=\\\"text-xs text-gray-500 mb-2\\\">\330\247\331\204\330\245\330\265\330\257\330\247\330\261 5.0.0 \342\200\242 420 MB</p>\\n              <div class=\\\"flex items-center justify-between\\\">\\n                <span class=\\\"text-xs font-bold bg-gray-50 px-2 py-1 rounded border border-gray-100\\\">4.2 \342\230\205</span>\\n                <span class=\\\"text-blue-600 text-xs font-bold\\\">\330\252\330\253\330\250\331\212\330\252</span>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <!-- Category Chips -->\\n      <section class=\\\"flex flex-col gap-4\\\">\\n        <h2 class=\\\"text-xl font-bold text-gray-800\\\">\330\252\330\265\331\201\330\255 \330\255\330\263\330\250 \330\247\331\204\331\206\331\210\330\271</h2>\\n        <div class=\\\"flex gap-3\\\">\\n          <button class=\\\"px-6 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium hover:border-blue-500 hover:text-blue-600 transition-colors shadow-sm\\\">\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \330\252\330\271\331\204\331\212\331\205\331\212\330\251</button>\\n          <button class=\\\"px-6 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium hover:border-blue-500 hover:text-blue-600 transition-colors shadow-sm\\\">\330\243\330\257\331\210\330\247\330\252 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251</button>\\n          <button class=\\\"px-6 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium hover:border-blue-500 hover:text-blue-600 transition-colors shadow-sm\\\">\331\205\331\206\330\265\330\247\330\252 \330\247\331\204\330\252\331\210\330\247\330\265\331\204</button>\\n          <button class=\\\"px-6 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium hover:border-blue-500 hover:text-blue-600 transition-colors shadow-sm\\\">\330\247\331\204\330\265\330\255\330\251 \331\210\330\247\331\204\330\261\331\212\330\247\330\266\330\251</button>\\n          <button class=\\\"px-6 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium hover:border-blue-500 hover:text-blue-600 transition-colors shadow-sm\\\">\330\247\331\204\330\252\330\265\331\210\331\212\330\261 \331\210\330\247\331\204\331\201\331\212\330\257\331\212\331\210</button>\\n        </div>\\n      </section>\\n    </main>\\n  </div>\\n</div>\\n                    </body>\\n                  </html>\n[AIS_METADATA_SECTION_END]"
    items {
      text: "Apply the \"Professional Polish\" design theme to the app.\n[AIS_METADATA_SECTION_START]\nDesign name: Professional Polish\nDesign instructions: Extract ONLY the styling (colors, fonts, spacing, borders, shadows, backgrounds, gradients) and layout patterns (flexbox/grid structure, component arrangement) from the Design HTML below. Do NOT replace or restructure the existing app\'s HTML elements \342\200\224 preserve all existing components, content, and functionality. Only modify CSS/styling and adjust layout containers as needed to match the theme\'s aesthetic.\nDesign HTML:                   <!doctype html>\\n                  <html style=\\\"height: 100%; margin: 0;\\\">\\n                    <head>\\n                      <meta charset=\\\"UTF-8\\\" />\\n                      <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n                      <script src=\\\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\\\"></script>\\n                      <link href=\\\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\\\" rel=\\\"stylesheet\\\" />\\n                      <style>\\n                        body { margin: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden; }\\n                        /* Fallback classes in case Tailwind fails to load in sandbox */\\n                        .h-full { height: 100%; }\\n                        .w-full { width: 100%; }\\n                        .flex { display: flex; }\\n                        .flex-col { flex-direction: column; }\\n                        .flex-1 { flex: 1 1 0%; }\\n                      </style>\\n                    </head>\\n                    <body>\\n                      <div class=\\\"w-[1024px] h-[768px] bg-[#F8FAFC] text-[#111827] flex flex-col font-sans overflow-hidden\\\" dir=\\\"rtl\\\">\\n  <!-- Header -->\\n  <header class=\\\"h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8 z-10 shrink-0\\\">\\n    <div class=\\\"flex items-center gap-8\\\">\\n      <div class=\\\"flex items-center gap-2\\\">\\n        <div class=\\\"w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center\\\">\\n          <div class=\\\"w-4 h-4 bg-white transform rotate-45\\\"></div>\\n        </div>\\n        <span class=\\\"text-xl font-bold tracking-tight text-[#2563EB]\\\">\331\205\330\252\330\254\330\261 \330\247\331\204\330\243\331\204\330\271\330\247\330\250</span>\\n      </div>\\n      <nav class=\\\"hidden md:flex gap-6 text-sm font-medium text-gray-500\\\">\\n        <a href=\\\"#\\\" class=\\\"text-blue-600 border-b-2 border-blue-600 h-16 flex items-center\\\">\330\247\331\204\330\243\331\204\330\271\330\247\330\250</a>\\n        <a href=\\\"#\\\" class=\\\"hover:text-blue-600 h-16 flex items-center\\\">\330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252</a>\\n        <a href=\\\"#\\\" class=\\\"hover:text-blue-600 h-16 flex items-center\\\">\330\247\331\204\330\243\330\267\331\201\330\247\331\204</a>\\n      </nav>\\n    </div>\\n    \\n    <div class=\\\"flex-1 max-w-xl px-12\\\">\\n      <div class=\\\"relative\\\">\\n        <input type=\\\"text\\\" placeholder=\\\"\330\247\330\250\330\255\330\253 \330\271\331\206 \330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\210\330\243\331\204\330\271\330\247\330\250...\\\" class=\\\"w-full bg-gray-100 border-none rounded-full py-2.5 pr-12 pl-4 text-sm focus:ring-2 focus:ring-blue-500 outline-none\\\">\\n        <div class=\\\"absolute right-4 top-2.5 text-gray-400\\\">\\n          <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\n            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"Hash21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\\\" />\\n          </svg>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"flex items-center gap-4\\\">\\n      <button class=\\\"p-2 text-gray-500 hover:bg-gray-100 rounded-full\\\">\\n        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-6 w-6\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\n          <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\\\" />\\n        </svg>\\n      </button>\\n      <div class=\\\"w-9 h-9 rounded-full bg-gradient-to-tr from-blue-400 to-indigo-600 border-2 border-white shadow-sm\\\"></div>\\n    </div>\\n  </header>\\n\\n  <div class=\\\"flex flex-1 overflow-hidden\\\">\\n    <!-- Sidebar -->\\n    <aside class=\\\"w-60 bg-white border-l border-gray-200 p-6 flex flex-col gap-2 shrink-0\\\">\\n      <div class=\\\"text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 pr-2\\\">\330\247\331\204\330\247\331\203\330\252\330\264\330\247\331\201</div>\\n      <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 bg-blue-50 text-blue-700 rounded-xl font-medium\\\">\\n        <span class=\\\"text-lg\\\">\360\237\216\256</span> \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \330\247\331\204\331\205\331\205\331\212\330\262\330\251\\n      </a>\\n      <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-xl font-medium transition-colors\\\">\\n        <span class=\\\"text-lg\\\">\360\237\223\210</span> \330\247\331\204\330\243\331\203\330\253\330\261 \330\261\331\210\330\247\330\254\330\247\331\213\\n      </a>\\n      <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-xl font-medium transition-colors\\\">\\n        <span class=\\\"text-lg\\\">\360\237\206\225</span> \330\243\330\255\330\257\330\253 \330\247\331\204\330\245\330\265\330\257\330\247\330\261\330\247\330\252\\n      </a>\\n      <div class=\\\"h-px bg-gray-100 my-4\\\"></div>\\n      <div class=\\\"text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 pr-2\\\">\330\247\331\204\331\201\330\246\330\247\330\252</div>\\n      <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-xl font-medium\\\">\330\243\331\204\330\271\330\247\330\250 \330\247\331\204\330\243\331\203\330\264\331\206</a>\\n      <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-xl font-medium\\\">\330\243\331\204\330\271\330\247\330\250 \330\247\331\204\330\260\331\203\330\247\330\241</a>\\n      <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-xl font-medium\\\">\330\261\331\212\330\247\330\266\330\251</a>\\n      <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-xl font-medium\\\">\330\247\330\263\330\252\330\261\330\247\330\252\331\212\330\254\331\212\330\251</a>\\n      <div class=\\\"mt-auto\\\">\\n        <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-2.5 text-gray-600 hover:bg-gray-50 rounded-xl font-medium border border-gray-100 shadow-sm bg-white\\\">\\n          <span class=\\\"text-lg\\\">\342\232\231\357\270\217</span> \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251\\n        </a>\\n      </div>\\n    </aside>\\n\\n    <!-- Content Area -->\\n    <main class=\\\"flex-1 overflow-hidden p-8 flex flex-col gap-8\\\">\\n      <!-- Featured Hero Section -->\\n      <section class=\\\"relative h-64 rounded-3xl overflow-hidden shrink-0 shadow-xl\\\">\\n        <div class=\\\"absolute inset-0 bg-gradient-to-l from-black/80 via-black/40 to-transparent z-10\\\"></div>\\n        <div class=\\\"absolute inset-0 bg-[url(\'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=1000\')] bg-cover bg-center\\\"></div>\\n        <div class=\\\"relative z-20 h-full flex flex-col justify-center px-12 text-white\\\">\\n          <span class=\\\"bg-blue-600 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full w-fit mb-4\\\">\331\204\330\271\330\250\330\251 \330\247\331\204\330\243\330\263\330\250\331\210\330\271</span>\\n          <h1 class=\\\"text-4xl font-black mb-2\\\">\330\243\330\263\330\267\331\210\330\261\330\251 \330\247\331\204\331\201\330\266\330\247\330\241: \330\247\331\204\331\207\330\254\331\210\331\205 \330\247\331\204\330\243\330\256\331\212\330\261</h1>\\n          <p class=\\\"text-gray-200 max-w-md mb-6 leading-relaxed\\\">\330\256\330\266 \331\205\330\271\330\247\330\261\331\203 \331\205\331\204\330\255\331\205\331\212\330\251 \331\201\331\212 \330\243\330\271\331\205\330\247\331\202 \330\247\331\204\331\205\330\254\330\261\330\251. \330\261\330\263\331\210\331\205\330\247\330\252 \331\205\330\260\331\207\331\204\330\251 \331\210\330\252\330\254\330\261\330\250\330\251 \331\204\330\271\330\250 \330\272\331\212\330\261 \331\205\330\263\330\250\331\210\331\202\330\251 \330\247\331\204\330\242\331\206 \330\271\331\204\331\211 \330\254\331\210\330\247\331\204\331\203.</p>\\n          <div class=\\\"flex gap-4\\\">\\n            <button class=\\\"bg-white text-black px-8 py-3 rounded-xl font-bold hover:bg-gray-100 transition-colors shadow-lg\\\">\330\252\330\253\330\250\331\212\330\252 \330\247\331\204\330\242\331\206</button>\\n            <button class=\\\"bg-white/20 backdrop-blur-md text-white px-8 py-3 rounded-xl font-bold hover:bg-white/30 transition-colors border border-white/30\\\">\330\247\331\204\330\252\331\201\330\247\330\265\331\212\331\204</button>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <!-- App Grid Section -->\\n      <section class=\\\"flex flex-col gap-4\\\">\\n        <div class=\\\"flex justify-between items-center\\\">\\n          <h2 class=\\