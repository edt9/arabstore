1\205\331\210\330\254\331\210\330\257 \331\210\331\204\331\203\331\206\331\207 \331\204\330\247 \331\212\330\271\331\205\331\204 \330\250\330\247\331\204\330\264\331\203\331\204 \330\247\331\204\331\205\330\267\331\204\331\210\330\250.\n\n\330\247\331\204\331\205\330\267\331\204\331\210\330\250:\n\n* \330\245\330\265\331\204\330\247\330\255 \330\254\331\205\331\212\330\271 \331\205\330\264\330\247\331\203\331\204 \330\247\331\204\331\210\330\266\330\271 \330\247\331\204\330\257\330\247\331\203\331\206.\n* \330\252\330\267\330\250\331\212\331\202\331\207 \330\271\331\204\331\211 \330\254\331\205\331\212\330\271 \330\265\331\201\330\255\330\247\330\252 \330\247\331\204\331\205\331\210\331\202\330\271.\n* \330\252\330\267\330\250\331\212\331\202\331\207 \330\243\331\212\330\266\331\213\330\247 \330\271\331\204\331\211 \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251.\n* \330\247\331\204\330\252\330\243\331\203\330\257 \331\205\331\206 \330\255\331\201\330\270 \330\247\330\256\330\252\331\212\330\247\330\261 \330\247\331\204\331\205\330\263\330\252\330\256\330\257\331\205 (\331\201\330\247\330\252\330\255 \330\243\331\210 \330\257\330\247\331\203\331\206) \331\210\330\271\330\257\331\205 \331\201\331\202\330\257\330\247\331\206\331\207 \330\271\331\206\330\257 \330\252\330\255\330\257\331\212\330\253 \330\247\331\204\330\265\331\201\330\255\330\251 \330\243\331\210 \330\245\330\271\330\247\330\257\330\251 \330\262\331\212\330\247\330\261\330\251 \330\247\331\204\331\205\331\210\331\202\330\271.\n* \330\247\331\204\330\252\330\243\331\203\330\257 \331\205\331\206 \330\243\331\206 \330\254\331\205\331\212\330\271 \330\247\331\204\330\271\331\206\330\247\330\265\330\261 (\330\247\331\204\330\256\331\204\331\201\331\212\330\247\330\252\330\214 \330\247\331\204\330\250\330\267\330\247\331\202\330\247\330\252\330\214 \330\247\331\204\330\243\330\262\330\261\330\247\330\261\330\214 \330\247\331\204\331\206\330\265\331\210\330\265\330\21