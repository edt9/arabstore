    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQE-QRvXYFoP2zN7VnRac_Mbhr4rUqzV5H5atI9MJF3al0Vf83vxz7idjDGA-BTMeq_PTSFOnMAKI_fg1foMfowmnIMJiGPf5ioUgToKlDumhtB6MqRbMKJeOa4iXfTwaLWsEXse_WT8yIBaRNCYrVlcjVArkRm_uoPdUj6RNExMUDxuye0D"
