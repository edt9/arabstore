          text: "            <span className=\"hover:text-blue-500 cursor-pointer\" onClick={() => setActiveTab(\"admin\")}>\330\250\331\210\330\247\330\250\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\330\271\330\247\331\205\330\251</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <p className=\"text-[10px] opacity-70\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            &copy; 2026 Google Play (\331\206\330\263\330\256\330\251 \330\271\330\261\330\250\331\212\330\251 \331\205\330\271\330\261\330\250\330\251 \331\210\331\205\330\267\331\210\330\261\330\251 \330\250\330\247\331\204\331\203\330\247\331\205\331\204)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </footer>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
