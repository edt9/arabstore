        }
        lines {
          text: "function readLocalGames(): Game[] {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!fs.existsSync(localGamesFile)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fs.writeFileSync(localGamesFile, JSON.stringify(seedGames, null, 2), \"utf8\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return seedGames;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
