        }
        lines {
          text: "async function addGameDB(game: Game): Promise<Game> {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (isSupabaseConfigured && supabase && !isGamesTableMissing) {"
