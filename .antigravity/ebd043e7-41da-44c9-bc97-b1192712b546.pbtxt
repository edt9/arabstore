      text: "\330\243\330\261\331\212\330\257 \330\245\330\254\330\261\330\247\330\241 \330\247\331\204\330\252\330\271\330\257\331\212\331\204\330\247\330\252 \330\247\331\204\330\252\330\247\331\204\331\212\330\251 \330\271\331\204\331\211 \330\247\331\204\331\205\330\264\330\261\331\210\330\271 \330\247\331\204\330\255\330\247\331\204\331\212 \330\257\331\210\331\206 \330\252\330\272\331\212\331\212\330\261 \330\243\331\212 \330\254\330\262\330\241 \330\242\330\256\330\261 \331\205\331\206 \330\247\331\204\331\205\331\210\331\202\330\271 \330\243\331\210 \330\247\331\204\330\252\330\243\330\253\331\212\330\261 \330\271\331\204\331\211 \330\247\331\204\331\210\330\270\330\247\330\246\331\201 \330\247\331\204\331\205\331\210\330\254\331\210\330\257\330\251.\n\n### 1. \330\245\330\265\331\204\330\247\330\255 \330\255\330\260\331\201 \330\247\331\204\330\243\331\204\330\271\330\247\330\250 \331\210\330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\205\331\206 \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251\n\n\331\212\331\210\330\254\330\257 \330\255\330\247\331\204\331\212\331\213\330\247 \330\262\330\261 \330\255\330\260\331\201 (\330\243\331\212\331\202\331\210\331\206\330\251 \330\263\331\204\330\251 \330\247\331\204\331\205\331\207\331\205\331\204\330\247\330\252) \330\257\330\247\330\256\331\204 \331\204\331\210\330\255\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251\330\214 \331\210\331\204\331\203\331\206\331\207 \331\204\330\247 \331\212\330\271\331\205\331\204 \330\250\330\247\331\204\330\264\331\203\331\204 \330\247\331\204\331\205\330\267\331\204\331\210\330\250.\n\n\330\247\331\204\331\205\330\267\331\204\331\210\330\250:\n\n* \330\271\331\206\330\257 \330\247\331\204\330\266\330\272\330\267 \330\271\331\204\331\211 \330\262\330\261 \330\247\331\204\330\255\330\260\331\201\330\214 \331\212\330\252\331\205 \330\255\330\260\331\201 \330\247\331\204\331\204\330\271\330\250