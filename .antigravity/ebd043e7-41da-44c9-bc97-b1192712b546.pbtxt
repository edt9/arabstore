    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHV4sTlwSPjruySgAPpvN4vszzJSqUzWDODeykrJ-u7O1IQTgyVoqsoX--tcxnJvNtlms5aFOm4CpctZgtYvV2QV4AQ9GUazr53TDCZkpZEdtHBtogd0vg2SJlz55VNteOS4T7Niy3M2cmUDZFdXnRBZ-UbwkTu4YxpeBOl8giEWT3KNeyRNckkUzLbipJNa2dPuCnm9cmT6TyS5VHt-VC_v2Eh"
