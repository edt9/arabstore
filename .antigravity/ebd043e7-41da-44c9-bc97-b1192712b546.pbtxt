        }
        lines {
          text: "// Helper to write local games file"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function writeLocalGames(games: Game[]): void {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  fs.writeFileSync(localGamesFile, JSON.stringify(games, null, 2), \"utf8\");"
