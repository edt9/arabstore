        }
        lines {
          text: "    } catch (err: any) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (isTableMissingError(err)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        isGamesTableMissing = true;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      logSupabaseFallback(\"insert\", err);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
