        lines {
          text: "    } catch (err: any) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      console.warn(\"Supabase insert failed, falling back to local storage:\", err?.message || err);"
