        lines {
          text: "CREATE POLICY \"\330\247\331\204\331\210\330\265\331\210\331\204 \330\247\331\204\330\271\330\247\331\205 \331\204\331\204\330\252\330\271\330\257\331\212\331\204\" ON games FOR UPDATE USING (true);"
